
NODE_ENV=production
PORT=9005

MONGO_URI=mongodb+srv://<user>:<password>@<cluster>/attendence?retryWrites=true&w=majority
MONGO_NAME=PlatformAdmin

JWT_SECRET=<generate-with: openssl rand -hex 32>
JWT_EXPIRES_IN=7d


CORS_ALLOWED_ORIGINS=https://yourdomain.com

MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USER=<you@gmail.com>
MAIL_PASSWORD=<gmail-app-password-no-spaces>

PLATFORM_ADMIN_EMAIL=<admin@email.com>
PLATFORM_ADMIN_NAME=Platform Admin
PLATFORM_ADMIN_PASSWORD=PlatformAdmin@123 

MAX_GPS_ACCURACY=300


AUTH_COMPANY_CACHE_TTL_MS=60000
AUTH_PERM_CACHE_TTL_MS=30000
AUTH_NEGATIVE_CACHE_TTL_MS=15000
